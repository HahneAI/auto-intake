# Password TJ uses to sign in at /admin
ADMIN_PASSWORD=

# Storage: added automatically when you connect Upstash Redis from Vercel → Storage.
# Without these, local dev keeps requests in memory only.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: also forward each request to a webhook (Make, Zapier) for text/email alerts later
INTAKE_WEBHOOK_URL=
